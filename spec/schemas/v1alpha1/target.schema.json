{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fxvcs.dev/schemas/v1alpha1/target.schema.json",
  "title": "Target (targets/<name>.yaml)",
  "description": "Mutable desired state for one deployment target: desired release, environment, logical agent/runtime binding, retention, secret provider routing, health policy, allowlisted hook requests, verifier bindings, and trust policy. No credentials, executable text, or host paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Target" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/kebab" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "environment", "agentID", "authority", "runtimeRef", "retention", "secrets"],
      "properties": {
        "release": { "$ref": "common.schema.json#/$defs/releaseName" },
        "environment": { "$ref": "common.schema.json#/$defs/kebab" },
        "agentID": { "$ref": "common.schema.json#/$defs/kebab" },
        "authority": { "type": "string", "enum": ["gitops", "cloud"] },
        "runtimeRef": { "$ref": "common.schema.json#/$defs/kebab" },
        "retention": { "$ref": "#/$defs/retentionPolicy" },
        "secrets": { "$ref": "#/$defs/secretPolicy" },
        "health": { "$ref": "#/$defs/healthPolicy" },
        "hooks": { "$ref": "#/$defs/hookRequests" },
        "verifiers": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/verifierBinding" }
        },
        "trust": { "$ref": "#/$defs/trustPolicy" }
      }
    }
  },
  "$defs": {
    "retentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keep"],
      "properties": {
        "keep": { "type": "integer", "minimum": 1 }
      }
    },
    "secretPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProvider"],
      "properties": {
        "defaultProvider": { "$ref": "common.schema.json#/$defs/kebab" },
        "namespaces": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/namespaceProvider" }
        }
      }
    },
    "namespaceProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "$ref": "common.schema.json#/$defs/kebab" }
      }
    },
    "healthPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startupGrace", "interval", "timeout", "successThreshold", "failureThreshold",
        "soakDuration", "onFailure", "maxAutomaticRollbacks", "rollbackWindow",
        "activationWindow", "maxPlayersForRestart", "checks"
      ],
      "properties": {
        "startupGrace": { "$ref": "common.schema.json#/$defs/duration" },
        "interval": { "$ref": "common.schema.json#/$defs/duration" },
        "timeout": { "$ref": "common.schema.json#/$defs/duration" },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "soakDuration": { "$ref": "common.schema.json#/$defs/duration" },
        "onFailure": { "type": "string", "enum": ["rollback", "keep", "none"] },
        "maxAutomaticRollbacks": { "type": "integer", "minimum": 0 },
        "rollbackWindow": { "$ref": "common.schema.json#/$defs/duration" },
        "activationWindow": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^window\\.v1;tz=[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*;days=(?:\\*|(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)(?:,(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun))*);start=(?:[01][0-9]|2[0-3]):[0-5][0-9];end=(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Optional portable weekly activation window: window.v1;tz=<IANA>;days=<*|canonical Mon..Sun list>;start=HH:MM;end=HH:MM. End is exclusive; null means no gate."
        },
        "maxPlayersForRestart": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Optional player-count gate; null means no gate."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/healthCheck" }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["tcp", "fivem-http", "rcon-status", "fxvcs-resource-state"] },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/[^\\s]*$" }
        }
      },
      "if": { "properties": { "type": { "const": "fivem-http" } } },
      "else": { "properties": { "endpoints": false } }
    },
    "hookRequests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postMaterialize": { "$ref": "#/$defs/hookList" },
        "preActivate": { "$ref": "#/$defs/hookList" },
        "postActivate": { "$ref": "#/$defs/hookList" },
        "onFailure": { "$ref": "#/$defs/hookList" }
      }
    },
    "hookList": {
      "type": "array",
      "items": { "$ref": "#/$defs/hookRequest" }
    },
    "hookRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/kebab" },
        "type": { "type": "string", "enum": ["template.v1"] },
        "template": { "$ref": "#/$defs/templateRef" },
        "destination": { "$ref": "common.schema.json#/$defs/relativePath" },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "inputs": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
          "additionalProperties": { "$ref": "input-source.schema.json" }
        }
      },
      "if": { "properties": { "type": { "const": "template.v1" } } },
      "then": { "required": ["template", "destination", "mode"] }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "digest"],
      "properties": {
        "repository": { "$ref": "common.schema.json#/$defs/displayName" },
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "digest": { "$ref": "common.schema.json#/$defs/digest" }
      }
    },
    "verifierBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "implementationVersion"],
      "properties": {
        "implementation": { "$ref": "common.schema.json#/$defs/kebab" },
        "implementationVersion": { "type": "integer", "minimum": 1 },
        "endpointRef": { "$ref": "common.schema.json#/$defs/kebab" }
      }
    },
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordination"],
      "properties": {
        "coordination": { "$ref": "#/$defs/coordinationTrust" }
      }
    },
    "coordinationTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "signatures"],
      "properties": {
        "authority": { "type": "string", "enum": ["signed-commit-tip", "signed-promotion-tag"] },
        "signatures": { "type": "string", "enum": ["required", "optional", "off"] },
        "allowedSignersFile": { "$ref": "common.schema.json#/$defs/relativePath" },
        "promotionTagPrefix": { "type": "string", "pattern": "^refs/tags/[^\\s]+/$" }
      }
    }
  }
}
