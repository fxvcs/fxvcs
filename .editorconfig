root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.lua]
indent_size = 4

[*.cfg]
indent_size = 4

# Fixtures may intentionally contain CRLF or missing final newlines.
[spec/fixtures/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[**/testdata/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
